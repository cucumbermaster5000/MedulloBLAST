# Configure in Cloud Variables. This example is never loaded automatically.
MB_AUTO_PROVISION_DATA=true
R2_DEPMAP_CACHE_DIR=/tmp/medulloblast-v1/cache
MB_DATA_ROOT=/tmp/medulloblast-v1/references
MB_MAX_WORKERS=1
MB_SESSION_IDLE_SECONDS=900
MB_INTEGRATED_REPORT=false
MB_REPORT_PDF=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
MB_WORKER_TIMEOUT_SECONDS=600
MB_PROVISION_TIMEOUT_SECONDS=1800
MB_ALLOW_DATA_DOWNLOADS=false
NCBI_EMAIL=davengis@gmail.com
NCBI_API_KEY=
# Optional for local full-PDF mode (MB_REPORT_PDF=true).
MB_REPORT_BROWSER=
